{
  "manifest_version": 3,
  "name": "Ladorian Cams",
  "version": "1.0.4",
  "description": "Captura la cámara, detecta rostros localmente con TensorFlow.js y puede enviar fotogramas por WebSocket a un servidor propio.",

  "action": {
    "default_popup": "index.html",
    "default_title": "Sender"
  },

  "background": {
    "service_worker": "bg.js"
  },

  "sandbox": {
    "pages": ["sandbox/detector.html"]
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'none';"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "js/*.js",
        "js/vendor/*.js",
        "models/blazeface/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "permissions": [],
  "host_permissions": []
}
