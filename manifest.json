{
  "manifest_version": 3,
  "name": "Ladorian Cams",
  "version": "2.0.0",
  "description": "Captura la cámara, detecta rostros localmente con face-api.js y envía eventos al backend de Ladorian.",

  "action": {
    "default_popup": "index.html",
    "default_title": "Ladorian Cams 2.0"
  },

  "background": {
    "service_worker": "bg.js"
  },

  "sandbox": {
    "pages": ["sandbox/detector.html"]
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'none';"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "face-api.min.js",
        "script.js",
        "config.json",
        "style.css",
        "models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "permissions": [],
  "host_permissions": [
    "https://people.ladorianids.es/*"
  ]
}
